<Window x:Class="TroLyMayTinh.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Trợ Lý Máy Tính" Width="1220" Height="810" MinWidth="980" MinHeight="660" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" TextElement.Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="LineHeight" Value="23"/></Style>
  <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style x:Key="NavItem" TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="#C3CEE3"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="17,13"/><Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#22314B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#335CDB"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#92B4FF"/><Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <DataTemplate x:Key="QuickToolTemplate">
   <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="18">
    <StackPanel>
     <DockPanel><Button DockPanel.Dock="Right" Content="{Binding Star}" Command="{Binding FavoriteCommand}" Background="Transparent" Foreground="{DynamicResource AccentBrush}" Padding="7" FontSize="22" ToolTip="Yêu thích / Favorite" AutomationProperties.Name="Favorite"/><TextBlock Text="{Binding Icon}" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/></DockPanel>
     <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,5"/>
     <TextBlock Text="{Binding Group}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,5"/>
     <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" MinHeight="43"/>
     <Button Content="{Binding DataContext.Labels[open], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding OpenCommand}" HorizontalAlignment="Left" Padding="14,8" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111D32">
   <DockPanel Margin="18,28,18,20">
    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,28">
     <Border Width="43" Height="43" Background="#335CDB" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,15"><TextBlock Text="⊞" Foreground="White" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="Trợ Lý" Foreground="White" FontSize="26" FontWeight="Bold"/>
     <TextBlock Text="Máy Tính" Foreground="#AFC0DF" FontSize="20"/>
     <TextBlock Text="WINDOWS TOOLKIT" Foreground="#7185A8" FontSize="10" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="12,20,0,0">
     <TextBlock Text="Triết Võ" Foreground="#B9C8E3" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding Labels[version]}" Foreground="#8193B2" FontSize="12" Margin="0,6,0,0"/>
    </StackPanel>
    <ListBox ItemsSource="{Binding Navigation}" SelectedIndex="{Binding Page, Mode=TwoWay}" ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,26,30,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding Title}" FontSize="29" FontWeight="Bold"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,6,15,0"/></StackPanel>
    <Border Grid.Column="1" VerticalAlignment="Top" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="13,8" Margin="10,5,0,0"><TextBlock Text="{Binding Architecture}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></Border>
   </Grid>
   <TabControl Grid.Row="1" SelectedIndex="{Binding Page, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
    <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
    <!-- Overview -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
     <Border CornerRadius="17" Padding="28" Margin="0,0,0,20"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2442A5" Offset="0"/><GradientStop Color="#526DE4" Offset="1"/></LinearGradientBrush></Border.Background>
      <StackPanel><TextBlock Text="{Binding Labels[tagline]}" Foreground="#D1DDFF" FontSize="13"/><TextBlock Text="{Binding Labels[welcome]}" Foreground="White" FontSize="27" FontWeight="Bold" Margin="0,12,0,10"/><TextBlock Text="{Binding Labels[welcomeSub]}" Foreground="#E4EBFF" LineHeight="24"/><WrapPanel Margin="0,23,0,0"><Button Content="{Binding Labels[apps]}" Command="{Binding AppsPageCommand}" Background="White" Foreground="#2442A5" Margin="0,0,10,8"/><Button Content="{Binding Labels[tools]}" Command="{Binding ToolsPageCommand}" Background="#425EC4" Margin="0,0,0,8"/></WrapPanel></StackPanel>
     </Border>
     <UniformGrid Columns="2" Margin="0,0,-12,0">
      <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{Binding Labels[device]}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Device}" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{Binding Labels[os]}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding WindowsVersion}" FontSize="17" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{Binding Labels[storage]}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding FreeSpace}" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{Binding Labels[arch]}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Architecture}" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
     </UniformGrid>
     <TextBlock Text="{Binding Labels[quick]}" Style="{StaticResource Section}" Margin="0,18,0,14"/>
     <WrapPanel><Button Content="{Binding Labels[scan]}" Command="{Binding CleanupPageCommand}" Margin="0,0,10,10"/><Button Content="{Binding Labels[builtIn]}" Command="{Binding ToolsPageCommand}" Style="{StaticResource Secondary}" Margin="0,0,10,10"/><Button Content="{Binding Labels[refresh]}" Command="{Binding RefreshCommand}" Style="{StaticResource Secondary}" Margin="0,0,0,10"/></WrapPanel>

     <WrapPanel Margin="0,12,0,12"><Button Content="{Binding Labels[winsettings]}" Command="{Binding WindowsSettingsPageCommand}" Margin="0,0,10,10"/><Button Content="{Binding Labels[utilities]}" Command="{Binding UtilitiesPageCommand}" Style="{StaticResource Secondary}" Margin="0,0,10,10"/><Button Content="{Binding Labels[setup]}" Command="{Binding SetupPageCommand}" Style="{StaticResource Secondary}" Margin="0,0,0,10"/></WrapPanel>
     <TextBlock Text="{Binding Labels[hardware]}" Style="{StaticResource Section}" Margin="0,12,0,12"/>
     <TextBlock Text="{Binding Labels[hardwareHint]}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
     <TextBlock Text="{Binding HardwareStatus}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
     <Button Content="{Binding Labels[exportHardware]}" Command="{Binding ExportHardwareCommand}" IsEnabled="{Binding NotBusy}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
     <ItemsControl ItemsSource="{Binding HardwareGroups}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource Section}"/><ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></TabItem>
    <!-- Software -->
    <TabItem><DockPanel Margin="0,0,10,0">
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Labels[category]}" Style="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Category, Mode=TwoWay}" Margin="0,0,0,12"/><WrapPanel IsEnabled="{Binding NotBusy}"><Button Content="{Binding Labels[officePreset]}" Command="{Binding OfficePresetCommand}" Style="{StaticResource Secondary}" Margin="0,0,8,10" Padding="12,8"/><Button Content="{Binding Labels[devPreset]}" Command="{Binding DeveloperPresetCommand}" Style="{StaticResource Secondary}" Margin="0,0,8,10" Padding="12,8"/><Button Content="{Binding Labels[clearApps]}" Command="{Binding ClearSoftwareCommand}" Style="{StaticResource Secondary}" Margin="0,0,0,10" Padding="12,8"/></WrapPanel><TextBlock Text="{Binding Labels[selectionHint]}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"/><TextBlock Text="{Binding Labels[search]}" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search software" Margin="0,0,0,14"/><WrapPanel IsEnabled="{Binding NotBusy}"><Button Content="{Binding Labels[install]}" Command="{Binding InstallCommand}" Margin="0,0,10,12"/><Button Content="{Binding Labels[detect]}" Command="{Binding DetectCommand}" Style="{StaticResource Secondary}" Margin="0,0,0,12"/></WrapPanel><TextBlock Text="{Binding Labels[publisherNote]}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,15"/><TextBlock Text="{Binding Labels[noApps]}" Visibility="{Binding NoApps, Converter={StaticResource BoolVisibility}}"/></StackPanel>
     <ListBox ItemsSource="{Binding SoftwareView}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding NotBusy}">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <CheckBox IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Top" Margin="0,5,0,0"/>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,3"/><TextBlock Text="{Binding CategoryText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,0,5"/><TextBlock Text="{Binding Publisher}" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding Id}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/><TextBlock Text="{Binding State}" Foreground="{DynamicResource AccentBrush}" Margin="0,7,0,0"/></StackPanel>
      </Grid></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel></TabItem>
    <!-- Cleanup -->
    <TabItem><Grid Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}"><TextBlock Text="{Binding Labels[cleanHint]}" Style="{StaticResource Muted}"/></Border>
     <WrapPanel Grid.Row="1"><Button Content="{Binding Labels[scan]}" Command="{Binding ScanCommand}" IsEnabled="{Binding NotBusy}" Margin="0,0,9,10"/><Button Content="{Binding Labels[delete]}" Command="{Binding DeleteCommand}" IsEnabled="{Binding NotBusy}" Background="#B63C4B" Margin="0,0,9,10"/><Button Content="{Binding Labels[cancel]}" Command="{Binding CancelCommand}" Style="{StaticResource Secondary}" Margin="0,0,0,10"/></WrapPanel>
     <StackPanel Grid.Row="2"><WrapPanel IsEnabled="{Binding NotBusy}"><Button Content="{Binding Labels[selectAll]}" Command="{Binding SelectAllCommand}" Style="{StaticResource Secondary}" Padding="12,7" Margin="0,0,8,10"/><Button Content="{Binding Labels[clearSelection]}" Command="{Binding ClearSelectionCommand}" Style="{StaticResource Secondary}" Padding="12,7" Margin="0,0,0,10"/></WrapPanel><TextBlock Text="{Binding CleanSummary}" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="{Binding Labels[emptyScan]}" Style="{StaticResource Muted}" Visibility="{Binding EmptyScan, Converter={StaticResource BoolVisibility}}"/></StackPanel>
     <ListBox Grid.Row="3" ItemsSource="{Binding CleanupFiles}" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" IsEnabled="{Binding NotBusy}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected}" AutomationProperties.Name="{Binding Name}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding PathText}" ToolTip="{Binding PathText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Date}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid></TabItem>
    <!-- Tweaks -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows Explorer" Style="{StaticResource Section}"/><StackPanel IsEnabled="{Binding NotBusy}"><CheckBox Content="{Binding Labels[extensions]}" IsChecked="{Binding Extensions}" Margin="0,8"/><CheckBox Content="{Binding Labels[hidden]}" IsChecked="{Binding Hidden}" Margin="0,8"/><WrapPanel Margin="0,18,0,8"><Button Content="{Binding Labels[apply]}" Command="{Binding ApplyTweaksCommand}" Margin="0,0,10,10"/><Button Content="{Binding Labels[restore]}" Command="{Binding RestoreTweaksCommand}" Style="{StaticResource Secondary}" Margin="0,0,0,10"/></WrapPanel></StackPanel><TextBlock Text="{Binding Labels[tweakHint]}" Style="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Labels[shortcuts]}" Style="{StaticResource Section}"/><WrapPanel><Button Content="{Binding Labels[startup]}" Command="{Binding StartupCommand}" Style="{StaticResource Secondary}" Margin="0,0,10,10"/><Button Content="{Binding Labels[recovery]}" Command="{Binding RecoveryCommand}" Style="{StaticResource Secondary}" Margin="0,0,0,10"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <!-- Toolbox -->
    <TabItem><DockPanel Margin="0,0,10,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Labels[quickSearch]}" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search shortcuts" Margin="0,0,0,10"/><CheckBox Content="{Binding Labels[favorites]}" IsChecked="{Binding FavoritesOnly}" Margin="0,0,0,10"/><TextBlock Text="{Binding Labels[favoriteHint]}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/><TextBlock Text="{Binding Labels[noQuick]}" Style="{StaticResource Muted}" Visibility="{Binding NoTools, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding ToolsView}" ItemTemplate="{StaticResource QuickToolTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></DockPanel></TabItem>
    <!-- Updates -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Labels[current]}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Version}" FontSize="35" FontWeight="Bold" Margin="0,7,0,15"/><TextBlock Text="{Binding UpdateStatus}" FontWeight="SemiBold" Margin="0,0,0,18"/><WrapPanel IsEnabled="{Binding NotBusy}"><Button Content="{Binding Labels[check]}" Command="{Binding CheckUpdateCommand}" Margin="0,0,10,10"/><Button Content="{Binding Labels[download]}" Command="{Binding UpdateCommand}" IsEnabled="{Binding CanUpdate}" Margin="0,0,10,10"/><Button Content="{Binding Labels[releasePage]}" Command="{Binding ReleasesCommand}" Style="{StaticResource Secondary}" Margin="0,0,0,10"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Labels[updateHint]}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ReleaseNotes}" Margin="0,20,0,0" LineHeight="24"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <!-- Activity -->
    <TabItem><DockPanel Margin="0,0,10,0"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,15"><Button Content="{Binding Labels[openLogs]}" Command="{Binding OpenLogsCommand}" Margin="0,0,10,10"/><Button Content="{Binding Labels[copyLogs]}" Command="{Binding CopyLogsCommand}" Style="{StaticResource Secondary}" Margin="0,0,0,10"/></WrapPanel><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="18"/></DockPanel></TabItem>
    <!-- Settings -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding NotBusy}"><CheckBox Content="{Binding Labels[dark]}" IsChecked="{Binding Dark}" Margin="0,10"/><CheckBox Content="{Binding Labels[english]}" IsChecked="{Binding English}" Margin="0,10"/><CheckBox Content="{Binding Labels[autoCheck]}" IsChecked="{Binding AutoCheck}" Margin="0,10"/><TextBlock Text="{Binding Labels[settingsHint]}" Style="{StaticResource Muted}" Margin="0,20,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <!-- About -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Trợ Lý Máy Tính" FontSize="29" FontWeight="Bold"/><TextBlock Text="{Binding Labels[version]}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,18"/><TextBlock Text="{Binding Labels[aboutText]}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Labels[author]}" FontWeight="SemiBold" Margin="0,20,0,15"/><Button Content="{Binding Labels[github]}" Command="{Binding GithubCommand}" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Labels[roadmap]}" Style="{StaticResource Section}"/><TextBlock Text="{Binding Labels[roadmapText]}" Style="{StaticResource Muted}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>

    <!-- Windows settings -->
    <TabItem><DockPanel Margin="0,0,10,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Labels[settingsHintWindows]}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/><TextBlock Text="{Binding Labels[quickSearch]}" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search shortcuts" Margin="0,0,0,10"/><CheckBox Content="{Binding Labels[favorites]}" IsChecked="{Binding FavoritesOnly}" Margin="0,0,0,10"/><TextBlock Text="{Binding Labels[favoriteHint]}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/><TextBlock Text="{Binding Labels[noQuick]}" Style="{StaticResource Muted}" Visibility="{Binding NoSettings, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding SettingsView}" ItemTemplate="{StaticResource QuickToolTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></DockPanel></TabItem>
    <!-- Quick utilities -->
    <TabItem><DockPanel Margin="0,0,10,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Labels[quickSearch]}" Style="{StaticResource Muted}" Margin="0,0,0,6"/><TextBox Text="{Binding QuickSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search shortcuts" Margin="0,0,0,10"/><CheckBox Content="{Binding Labels[favorites]}" IsChecked="{Binding FavoritesOnly}" Margin="0,0,0,10"/><TextBlock Text="{Binding Labels[favoriteHint]}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/><TextBlock Text="{Binding Labels[noQuick]}" Style="{StaticResource Muted}" Visibility="{Binding NoUtilities, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"/></StackPanel><Expander DockPanel.Dock="Bottom" Header="{Binding Labels[utilityResult]}" Foreground="{DynamicResource TextBrush}" IsExpanded="True" Margin="0,10,0,0"><StackPanel><Button Content="{Binding Labels[copyOutput]}" Command="{Binding CopyUtilityCommand}" HorizontalAlignment="Left" Padding="12,7" Margin="0,8,0,8"/><TextBox Text="{Binding UtilityOutput, Mode=OneWay}" IsReadOnly="True" Height="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></Expander><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding UtilitiesView}" ItemTemplate="{StaticResource QuickToolTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></DockPanel></TabItem>
    <!-- Windows Setup launcher -->
    <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Labels[setupTitle]}" Style="{StaticResource Section}"/><TextBlock Text="{Binding Labels[setupSteps]}" LineHeight="29" Margin="0,0,0,20"/><WrapPanel IsEnabled="{Binding NotBusy}"><Button Content="{Binding Labels[getWindows]}" Command="{Binding DownloadWindowsCommand}" Margin="0,0,10,10"/><Button Content="{Binding Labels[chooseSetup]}" Command="{Binding ChooseSetupCommand}" Margin="0,0,10,10"/><Button Content="{Binding Labels[recovery]}" Command="{Binding RecoveryCommand}" Style="{StaticResource Secondary}" Margin="0,0,0,10"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><TextBlock Text="{Binding Labels[setupLimit]}" Style="{StaticResource Muted}"/></Border></StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0"><StackPanel><ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,9" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" ToolTip="{Binding Status}"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
